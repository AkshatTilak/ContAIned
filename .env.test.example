# ──────────────────────────────────────────────
# ContAIned V8 Test Environment Configuration Template
# Copy to .env.test for local test runs with real services
# ──────────────────────────────────────────────
APP_NAME=contained-ai-platform-test
APP_ENV=test
APP_HOST=127.0.0.1
APP_PORT=8100

# Submodule loading
ACTIVE_PROJECTS=["syntraflow","guardroute","evalops"]

# Auth & Security
AUTH_ENABLED=true
JWT_SECRET_KEY=contained-test-jwt-secret-key-32-chars-min
DATASTORE_ENCRYPTION_KEY=contained-test-encryption-key-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
ALLOW_SELF_REGISTRATION=true
AUTO_APPROVE_EMAIL_DOMAINS=[]
ALLOW_MEMBER_HUB_CREATION=true

# Bootstrapped Test Admin Account
ADMIN_EMAIL=admin@contained.ai
ADMIN_PASSWORD=ChangeMe123!
TEST_USER_EMAIL=testuser@contained.ai
TEST_USER_PASSWORD=TestPass123!

# Test Databases (Isolated non-conflicting test ports against docker-compose.test.yml)
TEST_DATABASE_URL=postgresql+asyncpg://contained:contained_pass@localhost:5433/contained_platform_test
DATABASE_URL=postgresql+asyncpg://contained:contained_pass@localhost:5433/contained_platform_test
QDRANT_URL=http://localhost:6334
QDRANT_API_KEY=

NEO4J_URL=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=contained_pass

REDIS_URL=redis://localhost:6380

KAFKA_BOOTSTRAP_SERVERS=localhost:9093

# LLM & Evaluation Configuration
DEEPEVAL_MODEL=gemini/gemini-3.5-flash
OCR_PROVIDER=local
RAG_STRATEGY=hybrid

# API Keys (Set in .env.test for live API testing)
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Process Ports for Uvicorn Test Subprocesses
INFERENCE_SERVER_URL=http://localhost:8110
INFERENCE_SERVER_PORT=8110
