# --- Builder Stage ---
FROM python:3.11.9-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir poetry==2.0.1 poetry-plugin-export

COPY pyproject.toml poetry.lock* ./

# Configure poetry to install to a local virtualenv
RUN poetry config virtualenvs.in-project true \
    && poetry env use python3.11 \
    && (poetry check || poetry lock) \
    && poetry export --without-hashes --format=requirements.txt --extras=inference -o requirements.txt \
    && sed -i '/nvidia-/d' requirements.txt \
    && sed -i '/torch/d' requirements.txt \
    && .venv/bin/pip install --no-cache-dir -r requirements.txt \
    && .venv/bin/pip install --no-cache-dir torch==2.3.0 --index-url https://download.pytorch.org/whl/cpu

# --- Final Runner Stage ---
FROM python:3.11.9-slim AS runner

WORKDIR /app

# Create a non-root user and group
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -d /app -s /bin/bash appuser

# Copy virtualenv and application files from builder with proper ownership
COPY --chown=appuser:appgroup --from=builder /app/.venv /app/.venv
COPY --chown=appuser:appgroup common/ common/
COPY --chown=appuser:appgroup inference/ inference/

# Create models cache directory and assign ownership
RUN mkdir -p /app/models && \
    chown -R appuser:appgroup /app/models

# Set path to use virtualenv binaries
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

USER appuser

EXPOSE 8010

CMD ["uvicorn", "inference.main:app", "--host", "0.0.0.0", "--port", "8010"]
