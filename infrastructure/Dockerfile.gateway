# --- Builder Stage ---
FROM python:3.11.9-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir poetry==2.0.1

COPY pyproject.toml poetry.lock* ./

# Configure poetry to install to a local virtualenv
RUN poetry config virtualenvs.in-project true \
    && poetry env use python3.11 \
    && (poetry check || poetry lock) \
    && poetry install --no-interaction --no-ansi --no-root \
    --extras "syntraflow" --extras "guardroute" --extras "evalops"

# --- Final Runner Stage ---
FROM python:3.11.9-slim AS runner

WORKDIR /app

# Install runtime system deps (ffmpeg)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user and group
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -d /app -s /bin/bash appuser

# Copy virtualenv and application files from builder with proper ownership
COPY --chown=appuser:appgroup --from=builder /app/.venv /app/.venv
COPY --chown=appuser:appgroup common/ common/
COPY --chown=appuser:appgroup gateway/ gateway/
COPY --chown=appuser:appgroup projects/ projects/
COPY --chown=appuser:appgroup inference/__init__.py inference/__init__.py
COPY --chown=appuser:appgroup alembic.ini alembic.ini
COPY --chown=appuser:appgroup migrations/ migrations/
COPY --chown=appuser:appgroup .env.example .env.example

# Set path to use virtualenv binaries
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

USER appuser

EXPOSE 8000

CMD ["uvicorn", "gateway.main:app", "--host", "0.0.0.0", "--port", "8000"]
